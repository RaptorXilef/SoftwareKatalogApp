{
  "editor.formatOnSave": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [120],
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "files.eol": "\n",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "gremlins.showInProblemPane": true,
  "editor.formatOnType": false,
  "editor.formatOnPaste": false,

  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": false,
    "editor.formatOnSaveMode": "file"
  },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "[html]": { "editor.defaultFormatter": "biomejs.biome" },

  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": false,
    "dist/": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "dist/": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "dist/**": true
  },

  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.codeLens": true,

  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "files.insertFinalNewline": true,

  "workbench.iconTheme": "vira-icons-carbon",
  "workbench.productIconTheme": "viraUIIcons",
  "workbench.colorTheme": "Vira Carbon High Contrast",
  "viraTheme.accent": "White"
}
