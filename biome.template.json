{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!_Notizen",
      "!!.build",
      "!!.cache",
      "!!.debug",
      "!!*.md",
      "!!**/*.min.css",
      "!!**/*.min.js",
      "!!composer.lock",
      "!!data",
      "!!dist",
      "!!node_modules",
      "!!out",
      "!!package-lock.json",
      "!!public/assets",
      "!!vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noVar": "error",
        "noDebugger": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5",
      "bracketSpacing": true
    },
    "globals": ["window", "document", "navigator", "process", "module"]
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["*.json", "*.yml"],
      "formatter": {
        "indentWidth": 2
      }
    },
    {
      "includes": ["scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
