{
  "name": "software-katalog",
  "version": "1.7.0",
  "description": "Ein portabler Software-Katalog für das NAS",
  "main": "main.js",
  "author": "Felix Maywald / RaptorXilef",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://github.com/RaptorXilef/SoftwareKatalogApp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaptorXilef/SoftwareKatalogApp.git"
  },
  "bugs": {
    "url": "https://github.com/RaptorXilef/SoftwareKatalogApp/issues"
  },
  "scripts": {
    "start": "electron .",
    "scan": "node scanner.mjs",
    "scan:full": "node scanner.mjs --full",
    "build:dir": "electron-builder --dir",
    "build:dist": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "prepare": "husky",
    "chk:biome": "biome check .",
    "fix:biome": "biome check --write .",
    "release": "release-it"
  },
  "keywords": [
    "nas",
    "catalog",
    "electron",
    "portable"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.0",
    "husky": "^9.1.7",
    "release-it": "^21.1.2"
  },
  "build": {
    "appId": "io.github.raptorxilef.softwarekatalogapp",
    "productName": "Software Katalog",
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      "scanner.mjs"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SoftwareKatalog-Portable.exe"
    },
    "mac": {
      "target": "zip"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
