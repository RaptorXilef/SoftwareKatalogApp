{
  "name": "software-katalog",
  "version": "1.30.0",
  "description": "Ein portabler Software-Katalog für das NAS",
  "main": "./out/main/index.js",
  "author": "Felix Maywald / RaptorXilef",
  "license": "CC-BY-SA-4.0",
  "homepage": "https://github.com/RaptorXilef/SoftwareKatalogApp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaptorXilef/SoftwareKatalogApp.git"
  },
  "bugs": {
    "url": "https://github.com/RaptorXilef/SoftwareKatalogApp/issues"
  },
  "scripts": {
    "postinstall": "install-electron",
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "build:vite": "electron-vite build",
    "scan": "node src/scanner/scanner.mjs",
    "scan:full": "node src/scanner/scanner.mjs --full",
    "build:dir": "electron-vite build && electron-builder --dir",
    "build:dist": "electron-vite build && electron-builder --publish never",
    "build:portable": "electron-vite build && electron-builder --win portable --publish never",
    "test": "node --test tests",
    "prepare": "husky",
    "chk:biome": "biome check .",
    "fix:biome": "biome check --write .",
    "typecheck": "tsc -p jsconfig.json",
    "chk:unused": "knip",
    "release": "release-it"
  },
  "keywords": [
    "nas",
    "catalog",
    "electron",
    "portable"
  ],
  "dependencies": {
    "dompurify": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.0",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "io.github.raptorxilef.softwarekatalogapp",
    "productName": "Software Katalog",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "out/**/*",
      "!out/scanner/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/scanner/scanner.mjs",
        "to": "scanner.mjs"
      },
      {
        "from": "src/main/elevated-worker.mjs",
        "to": "elevated-worker.mjs"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "src/locales",
        "to": "locales",
        "filter": [
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "SoftwareKatalog-Setup-${arch}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Software Katalog",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "SoftwareKatalog-Portable.exe"
    },
    "mac": {
      "target": "zip"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ]
    }
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
